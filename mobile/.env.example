# Copy to .env and fill in from the Supabase dashboard (Project Settings -> API Keys).
# .env is git-ignored; this file carries the shape only and must never hold real values.
#
# Both variables are read at build time, not runtime. Expo inlines anything prefixed
# EXPO_PUBLIC_ into the bundle, so changing either one requires restarting the dev
# server with the cache cleared (`npx expo start --clear`).
#
# The publishable key is a client-side key by design — it ships inside the app bundle
# and is not a secret. What protects the data is row-level security, not this key.
# The service-role key is a different thing entirely and must never appear here.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
